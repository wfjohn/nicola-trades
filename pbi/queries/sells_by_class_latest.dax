// Model: Beta SIMCORP Pending Transactions
// Pending sells by share class and dealing date for one snapshot (set the date), including the
// real estate queue Simcorp parks at 2029-12-31.  ->  python -m pbi.load byclass <result>
EVALUATE
SUMMARIZECOLUMNS(
  'Pending Trades'[Date], 'Pending Trades'[Fund Name], 'Pending Trades'[Fund ID], 'Pending Trades'[Trade Date],
  TREATAS({DATE(2026,11,6)}, 'Pending Trades'[Date]),
  TREATAS({"Simcorp"}, 'Pending Trades'[source]),
  TREATAS({"Sell", "Sell-Swap"}, 'Pending Trades'[Tx Type]),
  FILTER(ALL('Pending Trades'[Trade Date]), 'Pending Trades'[Trade Date] > DATE(2026,11,6)),
  TREATAS({"Private Debt", "Private Equity LP", "U.S. Real Estate LP", "Canadian Real Estate LP",
           "Global Infrastructure LP", "Canadian Mortgage", "U.S. Mortgage", "Diversified Real Estate",
           "Diversified Private Assets", "Venture Capital LP", "Value Add Real Estate LP"}, 'Pending Trades'[Fund Name]),
  "n", COUNTROWS('Pending Trades'),
  "g", SUMX('Pending Trades', ABS('Pending Trades'[Gross Amt])))
